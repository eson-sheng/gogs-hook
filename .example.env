; 必填，与 Gogs Webhook 密钥一致，部署时替换为随机强密钥。
GOGS_SIGNATURE = ''
; JSON：local 代表本机，其余键是 o 的精确值；每个服务器只能操作自己的目录。
; 默认拒绝所有目标。目录必须是绝对路径，不允许通配符、子目录匹配或 ../。
; 本地目录需填写 realpath 后的规范路径，不带末尾斜杠。
; 示例：'{"local":["/home/www/local-app"],"192.168.1.100":["/home/www/item/path"]}'
ALLOWED_TARGETS = '{}'
; 远程服务器上的 Nginx 可执行文件，建议填写实际绝对路径。
; 示例：NGINX_BIN = '/www/server/nginx/sbin/nginx'
NGINX_BIN = 'nginx'
; 可选，按 o 的精确值覆盖默认路径；未配置的服务器使用 NGINX_BIN。
; 示例：'{"112.74.83.111":"/www/server/nginx/sbin/nginx","192.168.1.100":"/usr/sbin/nginx"}'
NGINX_BINS = '{}'
